{
  "name": "iq-tag-status",
  "version": "1.0.0",
  "private": true,
  "description": "PressurePro IQ NFC tag status page — API Gateway HTTP API → Lambda → RDS",
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && (cd dist && zip -q ../function.zip handler.js)",
    "encode": "node scripts/encode.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
